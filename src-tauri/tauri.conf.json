{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Realme Link",
  "version": "0.1.0",
  "identifier": "dev.realmelink.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Realme Link",
        "width": 1080,
        "height": 740,
        "minWidth": 880,
        "minHeight": 620,
        "decorations": true,
        "backgroundColor": "#0b0c10"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
